#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

// Conv1x1 / MatMul GEMM for devices with no cooperative matrix.
//   OUT[M, N] = act(X[M, K] * W[N, K]^T + bias + residual)
// fp16 in memory, fp32 accumulate in increasing K. No subgroup builtins.
// A BM x BK / B BN x BK tile is converted to fp32 once and stored k-major
// in shared memory, so each thread reads its TM / TN run as whole vectors
// (A is a broadcast within a subgroup row). The next tile's global loads
// are issued before the current tile's FMAs. Each thread keeps TM x TN
// fp32 accumulators: pin an 8-lane subgroup where the device allows it,
// wider SIMD spills them. Bindings and the 16-byte push constant match
// conv1x1_cm.
//
// -DDIRECT (devices that cannot pin a narrow subgroup, e.g. Adreno wave64):
// each tile goes straight from global memory into shared memory, no
// register prefetch (Adreno's compiler miscomputes the prefetch form);
// tiles stay fp16 in shared memory with BK 8 (Adreno 750: 30% faster than
// fp32 tiles with BK 16), the tail stages through its own fp32 array.
//
// flags: bit0 hasBias, bit1 hasResidual, bit3 dual output, bits[4:7] activation
//   act: 0=none 1=relu 2=gelu 3=hardswish 4=sigmoid
//   bit10 (1024): dual output stores the pre-activation value

#ifndef BM
#define BM 64u
#endif
#ifndef BN
#define BN 64u
#endif
#if defined(DIRECT) && !defined(BK)
#define BK 8u
#endif
#ifndef BK
#define BK 16u
#endif
#ifndef TM
#define TM 8u
#endif
#ifndef TN
#define TN 8u
#endif

#define NTX (BN / TN)
#define NTY (BM / TM)
#define NTHR (NTX * NTY)
#define AK (BK / 4u)
#define AV ((BM * AK + NTHR - 1u) / NTHR)
#define BV ((BN * AK + NTHR - 1u) / NTHR)

layout(local_size_x = NTHR) in;

layout(set = 0, binding = 0) readonly buffer X { f16vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer W { f16vec4 w[]; };
layout(set = 0, binding = 2) readonly buffer Bias { float16_t bias[]; };
layout(set = 0, binding = 3) readonly buffer Res { float16_t res[]; };
layout(set = 0, binding = 4) writeonly buffer O { float16_t o[]; };
layout(set = 0, binding = 5) writeonly buffer O2 { float16_t o2[]; };

layout(push_constant) uniform PC { uint mDim; uint nDim; uint kDim; uint flags; } p;

// As = S[0, BK*BM), Bs = S[BK*BM, ...); after the K loop each thread stages
// one accumulator row at S[tid*TN, +TN), so BK*(BM+BN) >= NTHR*TN
#ifdef DIRECT
shared float16_t S[BK * (BM + BN)];
shared float St[NTHR * TN];
#define LDS(v) float(v)
#else
shared float S[BK * (BM + BN)];
#define St S
#define LDS(v) (v)
#endif
#define As(i) S[i]
#define Bs(i) S[BK * BM + (i)]

float erf1(float v)
{
    float s = v < 0.0 ? -1.0 : 1.0;
    v = abs(v);
    float t = 1.0 / (1.0 + 0.47047 * v);
    float q = t * (0.3480242 + t * (-0.0958798 + t * 0.7478556));
    return s * (1.0 - q * exp(-v * v));
}

float16_t actf(float v, uint act, uint flg)
{
    if (act == 1u) return float16_t(max(v, 0.0));
    if (act == 2u) return float16_t(0.5 * v * (1.0 + erf1(v * 0.70710678118654752)));
    if (act == 3u) { float a = unpackHalf2x16(flg >> 16).x; float hs = clamp(v * a + 0.5, 0.0, 1.0); return float16_t(v * hs); }
    if (act == 4u) return float16_t(1.0 / (1.0 + exp(-v)));
    return float16_t(v);
}

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint tx = tid % NTX;
    uint ty = tid / NTX;
    uint m0 = gl_WorkGroupID.x * BM;
    uint n0 = gl_WorkGroupID.y * BN;
    uint kv = p.kDim >> 2u;

    float acc[TM * TN];
    for (uint i = 0u; i < TM * TN; i++) acc[i] = 0.0;

    f16vec4 z = f16vec4(float16_t(0.0));
#ifndef DIRECT
    f16vec4 ra[AV];
    f16vec4 rb[BV];
    for (uint t = 0u; t < AV; t++)
    {
        uint e = tid + t * NTHR;
        uint r = e / AK, cv = e - r * AK;
        uint gm = m0 + r, gk = cv * 4u;
        ra[t] = (e < BM * AK && gm < p.mDim && gk < p.kDim) ? x[gm * kv + (gk >> 2u)] : z;
    }
    for (uint t = 0u; t < BV; t++)
    {
        uint e = tid + t * NTHR;
        uint r = e / AK, cv = e - r * AK;
        uint gn = n0 + r, gk = cv * 4u;
        rb[t] = (e < BN * AK && gn < p.nDim && gk < p.kDim) ? w[gn * kv + (gk >> 2u)] : z;
    }
#endif

    for (uint k0 = 0u; k0 < p.kDim; k0 += BK)
    {
        for (uint t = 0u; t < AV; t++)
        {
            uint e = tid + t * NTHR;
            if (e < BM * AK)
            {
                uint r = e / AK, cv = e - r * AK;
#ifdef DIRECT
                uint gm = m0 + r, gk = k0 + cv * 4u;
                f16vec4 f = (gm < p.mDim && gk < p.kDim) ? x[gm * kv + (gk >> 2u)] : z;
#else
                vec4 f = vec4(ra[t]);
#endif
                As((cv * 4u + 0u) * BM + r) = f.x;
                As((cv * 4u + 1u) * BM + r) = f.y;
                As((cv * 4u + 2u) * BM + r) = f.z;
                As((cv * 4u + 3u) * BM + r) = f.w;
            }
        }
        for (uint t = 0u; t < BV; t++)
        {
            uint e = tid + t * NTHR;
            if (e < BN * AK)
            {
                uint r = e / AK, cv = e - r * AK;
#ifdef DIRECT
                uint gn = n0 + r, gk = k0 + cv * 4u;
                f16vec4 f = (gn < p.nDim && gk < p.kDim) ? w[gn * kv + (gk >> 2u)] : z;
#else
                vec4 f = vec4(rb[t]);
#endif
                Bs((cv * 4u + 0u) * BN + r) = f.x;
                Bs((cv * 4u + 1u) * BN + r) = f.y;
                Bs((cv * 4u + 2u) * BN + r) = f.z;
                Bs((cv * 4u + 3u) * BN + r) = f.w;
            }
        }
        barrier();
#ifndef DIRECT
        uint k1 = k0 + BK;
        if (k1 < p.kDim)
        {
            for (uint t = 0u; t < AV; t++)
            {
                uint e = tid + t * NTHR;
                uint r = e / AK, cv = e - r * AK;
                uint gm = m0 + r, gk = k1 + cv * 4u;
                ra[t] = (e < BM * AK && gm < p.mDim && gk < p.kDim) ? x[gm * kv + (gk >> 2u)] : z;
            }
            for (uint t = 0u; t < BV; t++)
            {
                uint e = tid + t * NTHR;
                uint r = e / AK, cv = e - r * AK;
                uint gn = n0 + r, gk = k1 + cv * 4u;
                rb[t] = (e < BN * AK && gn < p.nDim && gk < p.kDim) ? w[gn * kv + (gk >> 2u)] : z;
            }
        }
#endif
        for (uint kk = 0u; kk < BK; kk++)
        {
            float a[TM];
            float b[TN];
            for (uint i = 0u; i < TM; i++) a[i] = LDS(As(kk * BM + ty * TM + i));
            for (uint j = 0u; j < TN; j++) b[j] = LDS(Bs(kk * BN + tx * TN + j));
            for (uint i = 0u; i < TM; i++)
                for (uint j = 0u; j < TN; j++)
                    acc[i * TN + j] = fma(a[i], b[j], acc[i * TN + j]);
        }
        barrier();
    }

    uint act = (p.flags >> 4) & 7u;
    bool hasBias = (p.flags & 1u) != 0u;
    bool hasRes = (p.flags & 2u) != 0u;
    bool dual = (p.flags & 8u) != 0u;
    bool dualRaw = (p.flags & 1024u) != 0u;
    uint mBase = m0 + ty * TM;
    uint nBase = n0 + tx * TN;
#ifdef SIMPLE
    {
        // act 0 / 1 / 3 and no dual output only (host-selected): fully
        // unrolled. Compiled next to the staged tail below, Intel's compiler
        // spills the main loop, so the two tails are separate binaries.
        float hsA = act == 3u ? unpackHalf2x16(p.flags >> 16).x : 0.0;
        for (uint i = 0u; i < TM; i++)
        {
            uint gm = mBase + i;
            if (gm >= p.mDim) continue;
            for (uint j = 0u; j < TN; j++)
            {
                uint gn = nBase + j;
                if (gn >= p.nDim) continue;
                float v = acc[i * TN + j];
                if (hasBias) v += float(bias[gn]);
                if (hasRes) v += float(res[gm * p.nDim + gn]);
                if (act == 1u) v = max(v, 0.0);
                if (act == 3u) v *= clamp(v * hsA + 0.5, 0.0, 1.0);
                o[gm * p.nDim + gn] = float16_t(v);
            }
        }
    }
#else
    // gelu / sigmoid / dual: one non-unrolled body instead of TM*TN inlined
    // copies, which push the accumulators into spills
    for (uint i = 0u; i < TM; i++)
    {
        for (uint j = 0u; j < TN; j++) St[tid * TN + j] = acc[i * TN + j];
        uint gm = mBase + i;
        if (gm >= p.mDim) continue;
        [[dont_unroll]] for (uint j = 0u; j < TN; j++)
        {
            uint gn = nBase + j;
            if (gn >= p.nDim) continue;
            float v = St[tid * TN + j];
            if (hasBias) v += float(bias[gn]);
            if (hasRes) v += float(res[gm * p.nDim + gn]);
            o[gm * p.nDim + gn] = actf(v, act, p.flags);
            if (dual)
                o2[gm * p.nDim + gn] = dualRaw ? float16_t(v) : actf(v, 2u, p.flags);
        }
    }
#endif
}
