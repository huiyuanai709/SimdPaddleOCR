<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>Sdcb.SimdPaddleOCR</AssemblyName>
    <RootNamespace>Sdcb.SimdPaddleOCR</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>preview</LangVersion>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
  </PropertyGroup>
  <!--
    .NET 11 can compile async methods against the runtime's async machinery
    ("runtime async" / "async2") instead of Roslyn-generated state machines.
    Only net11.0 supports it; net10.0 and netstandard2.0 keep the classic
    state-machine implementation. Opt out with -p:UseRuntimeAsync=false.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' and '$(UseRuntimeAsync)' != 'false'">
    <Features Condition="'$(Features)' == ''">runtime-async=on</Features>
    <Features Condition="'$(Features)' != ''">$(Features);runtime-async=on</Features>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sdcb.SimdPaddleOCR.ModelProvider\Sdcb.SimdPaddleOCR.ModelProvider.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="linqpad-samples\*.linq" Pack="true" PackagePath="linqpad-samples" />
  </ItemGroup>
  <!-- ns2.0 不包含 GPU 后端，不嵌入 SPIR-V / Metal shader。net11 与 net10 都嵌入。 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <EmbeddedResource Include="Backends\Vulkan\Shaders\*.spv" />
    <None Remove="Backends\Vulkan\Shaders\*.spv" />
    <EmbeddedResource Include="Backends\Metal\Shaders\*.metal" />
    <None Remove="Backends\Metal\Shaders\*.metal" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Backends/**/*.cs" />
    <PackageReference Include="Microsoft.Bcl.Numerics" Version="10.0.11" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <Compile Remove="**/*Avx*.cs" />
    <Compile Remove="**/*Avx512*.cs" />
    <Compile Remove="**/*AdvSimd.cs" />
    <Compile Remove="Kernels/Conv1x1.Int8Vnni.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Sdcb.SimdPaddleOCR" />
  </ItemGroup>
</Project>
